(FPCore (b a c) :name "quadratic_root" :precision binary64 :pre (and (<= 10000000.0 b 100000000.0) (<= 1.0 a 1.0000001) (<= 1.0 c 2.0))
  (/ (+ (- b) (sqrt (- (* b b) (* (* 4.0 a) c)))) (* 2.0 a)))
(FPCore (a b c) :name "variance" :precision binary64 :pre (and (<= 1000000.0 a 1000001.0) (<= 1000000.0 b 1000001.0) (<= 1000000.0 c 1000001.0))
  (- (/ (+ (+ (* a a) (* b b)) (* c c)) 3.0) (* (/ (+ (+ a b) c) 3.0) (/ (+ (+ a b) c) 3.0))))
(FPCore (a b) :name "sq_expand" :precision binary64 :pre (and (<= 100000.0 a 1000000.0) (<= 1e-06 b 1e-05))
  (- (* (+ a b) (+ a b)) (* (- a b) (- a b))))
(FPCore (x y) :name "cube_diff" :precision binary64 :pre (and (<= 1000.0 x 1000.001) (<= 999.999 y 1000.0))
  (- (* (* x x) x) (* (* y y) y)))
(FPCore (x) :name "exp_minus_one" :precision binary64 :pre (and (<= 1e-12 x 1e-06))
  (- (exp x) 1.0))
(FPCore (x) :name "log_one_plus" :precision binary64 :pre (and (<= 1e-12 x 1e-06))
  (log (+ 1.0 x)))
(FPCore (x) :name "exp_series" :precision binary64 :pre (and (<= 0.1 x 3.0))
  (+ (+ (+ (+ (+ (+ (+ 1.0 (/ x 1.0)) (/ (* x x) 2.0)) (/ (* (* x x) x) 6.0)) (/ (* (* (* x x) x) x) 24.0)) (/ (* (* (* (* x x) x) x) x) 120.0)) (/ (* (* (* (* (* x x) x) x) x) x) 720.0)) (/ (* (* (* (* (* (* x x) x) x) x) x) x) 5040.0)))
(FPCore (x y) :name "hypot" :precision binary64 :pre (and (<= 1e+150 x 1e+155) (<= 1e+150 y 1e+155))
  (sqrt (+ (* x x) (* y y))))
(FPCore (x) :name "ratio_cancel" :precision binary64 :pre (and (<= 1.0000001 x 1.001))
  (/ (- (* x x) 1.0) (- x 1.0)))
