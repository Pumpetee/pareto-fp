(FPCore (x) :name "diff_sqrt" :precision binary64 :pre (and (<= 1000000.0 x 1000000000.0))
  (- (sqrt (+ x 1.0)) (sqrt x)))
(FPCore (x) :name "poly" :precision binary64 :pre (and (<= 0.5 x 2.0))
  (+ (+ (+ 1.5 (* 2.5 x)) (* 3.5 (* x x))) (* 4.5 (* x (* x x)))))
(FPCore (a c b) :name "two_div" :precision binary64 :pre (and (<= 1.0 a 2.0) (<= 3.0 c 4.0) (<= 1.0 b 2.0))
  (+ (/ a c) (/ b c)))
(FPCore (a b c) :name "div_chain" :precision binary64 :pre (and (<= 1.0 a 2.0) (<= 3.0 b 4.0) (<= 5.0 c 6.0))
  (/ (/ a b) c))
(FPCore (a b) :name "log_ratio" :precision binary64 :pre (and (<= 100.0 a 200.0) (<= 2.0 b 3.0))
  (- (log a) (log b)))
(FPCore (a b) :name "exp_sum" :precision binary64 :pre (and (<= 0.1 a 2.0) (<= 0.1 b 2.0))
  (* (exp a) (exp b)))
(FPCore (x y) :name "sq_diff" :precision binary64 :pre (and (<= 1000.0 x 1000.001) (<= 999.999 y 1000.0))
  (- (* x x) (* y y)))
